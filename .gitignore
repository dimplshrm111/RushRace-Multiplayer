# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.bun/

# ── Next.js / build output ───────────────────────────────────
/.next/
/out/
/build/
/dist/
next-env.d.ts
*.tsbuildinfo

# ── Environment and secrets ──────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
.claude
.z-ai-config

# ── Local databases ──────────────────────────────────────────
db/*.db*
db/*.sqlite
db/*.sqlite3
prisma/*.db*

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev.log
server.log

# ── Test / tooling artifacts ─────────────────────────────────
/coverage
.nyc_output/
/tool-results/
/test-results/
/playwright-report/
/.turbo/
/.eslintcache
/.cache/
test
prompt

# ── Local runtime files ──────────────────────────────────────
*.pid
local-*
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# ── OS / editor files ────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/

# ── Deployment ───────────────────────────────────────────────
.vercel
.netlify

# ── Python (helper scripts) ──────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/

# ── Project-local agent data ─────────────────────────────────
/skills/
